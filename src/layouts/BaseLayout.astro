---
interface Props {
  title?: string;
}
const { title = 'Link Vault' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | Link Vault</title>
    <link rel="icon" type="image/svg+xml" href="/link-vault/favicon.svg" />
    <link href="https://fonts.googleapis.com/css2?family=Lato:wght@300;400;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-space-deepest text-white font-sans min-h-screen">
    <nav class="border-b border-space-steel/30 px-6 py-4 flex items-center justify-between">
      <a href="/link-vault" class="font-light tracking-[6px] text-sm text-gradient-space hover:opacity-80 transition-opacity">
        LINK VAULT
      </a>
      <div class="flex gap-6 text-sm text-space-steel">
        <a href="/link-vault/bookmarks" class="hover:text-white transition-colors tracking-widest uppercase text-xs">All</a>
        <a href="/link-vault/tags" class="hover:text-white transition-colors tracking-widest uppercase text-xs">Tags</a>
      </div>
    </nav>
    <main class="max-w-5xl mx-auto px-6 py-10">
      <slot />
    </main>
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
