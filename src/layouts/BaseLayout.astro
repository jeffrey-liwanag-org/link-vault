---
import '../styles/global.css';
interface Props {
  title?: string;
}
const { title = 'Link Vault' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | Link Vault</title>
    <link rel="icon" type="image/svg+xml" href="/link-vault/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-ink-50 text-ink-950 font-sans min-h-screen">

    <!-- Nav -->
    <header class="fixed top-0 left-0 right-0 z-[100] bg-ink-950 border-b border-ink-700" data-pagefind-ignore>
      <nav class="max-w-6xl mx-auto px-6 h-14 flex items-center justify-between">
        <a href="/link-vault" class="flex items-center gap-2.5">
          <div class="w-6 h-6 rounded-full bg-indigo-600 flex items-center justify-center flex-shrink-0">
            <div class="w-2 h-2 rounded-full bg-white"></div>
          </div>
          <span class="font-bold text-sm text-white tracking-tight">Link Vault</span>
        </a>

        <div class="flex items-center gap-1">
          <a href="/link-vault/bookmarks"
             class="px-3 py-1.5 text-sm font-medium text-ink-400 hover:text-white hover:bg-ink-700 rounded-lg transition-all">
            Bookmarks
          </a>
          <a href="/link-vault/tags"
             class="px-3 py-1.5 text-sm font-medium text-ink-400 hover:text-white hover:bg-ink-700 rounded-lg transition-all">
            Tags
          </a>
          <a href="/link-vault"
             class="ml-2 px-4 py-1.5 rounded-lg bg-indigo-600 text-white text-sm font-medium hover:bg-indigo-500 transition-colors">
            Home
          </a>
        </div>
      </nav>
    </header>

    <main class="pt-14 pb-20">
      <slot />
    </main>

    <script>
      const observer = new IntersectionObserver(
        (entries) => entries.forEach(e => {
          if (e.isIntersecting) {
            e.target.classList.add('revealed');
            observer.unobserve(e.target);
          }
        }),
        { threshold: 0.08 }
      );
      document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
    </script>
  </body>
</html>
