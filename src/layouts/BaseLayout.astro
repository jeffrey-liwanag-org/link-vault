---
import '../styles/global.css';
interface Props {
  title?: string;
}
const { title = 'Link Vault' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | Link Vault</title>
    <link rel="icon" type="image/svg+xml" href="/link-vault/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <script src="https://code.iconify.design/iconify-icon/1.0.7/iconify-icon.min.js"></script>
  </head>
  <body class="bg-[#f1f5f9] text-slate-800 font-sans min-h-screen">

    <!-- Dot grid background -->
    <div class="fixed inset-0 bg-grid opacity-30 pointer-events-none"></div>

    <!-- Glassmorphism nav -->
    <nav class="fixed top-0 left-0 right-0 z-50 glass border-b border-slate-200/50">
      <div class="max-w-6xl mx-auto px-6 h-20 flex items-center justify-between">
        <a href="/link-vault" class="flex items-center gap-2.5 group">
          <div class="w-10 h-10 bg-emerald-500 rounded-xl flex items-center justify-center text-white shadow-lg shadow-emerald-200/50">
            <iconify-icon icon="lucide:bookmark" class="text-xl"></iconify-icon>
          </div>
          <span class="text-xl font-black tracking-tight text-slate-900 group-hover:text-emerald-600 transition-colors">
            LINK VAULT
          </span>
        </a>
        <div class="flex items-center gap-2">
          <a href="/link-vault/bookmarks"
             class="px-4 py-2 rounded-xl text-sm font-bold text-slate-500 hover:text-slate-900 hover:bg-white/80 transition-all">
            All Bookmarks
          </a>
          <a href="/link-vault/tags"
             class="px-4 py-2 rounded-xl text-sm font-bold text-slate-500 hover:text-slate-900 hover:bg-white/80 transition-all">
            Tags
          </a>
        </div>
      </div>
    </nav>

    <main class="max-w-6xl mx-auto px-6 pt-32 pb-20 relative">
      <slot />
    </main>
  </body>
</html>

