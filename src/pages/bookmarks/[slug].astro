---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TagChip from '../../components/TagChip.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const bookmarks = await getCollection('bookmarks');
  return bookmarks.map(b => ({ params: { slug: b.slug }, props: { bookmark: b } }));
}

const { bookmark } = Astro.props;
const { data } = bookmark;
const domain = new URL(data.url).hostname.replace('www.', '');
const dateStr = data.savedAt.toLocaleDateString('en-GB', { day: '2-digit', month: 'long', year: 'numeric' });
---
<BaseLayout title={data.title}>
  <div class="max-w-2xl mx-auto">

    <!-- Back link -->
    <a href="/link-vault/bookmarks" class="inline-flex items-center gap-2 font-bold text-sm text-slate-400 hover:text-emerald-600 transition-colors mb-8">
      <iconify-icon icon="lucide:arrow-left"></iconify-icon>
      All bookmarks
    </a>

    <!-- Card -->
    <div class="bg-white border border-slate-100 rounded-6xl p-8 shadow-sm">

      {data.screenshot && (
        <div class="rounded-5xl overflow-hidden border border-slate-100 mb-8">
          <img src={data.screenshot} alt={data.title} class="w-full" />
        </div>
      )}

      <!-- Domain -->
      <div class="flex items-center gap-2 mb-4">
        <div class="w-7 h-7 bg-sky-100 rounded-lg flex items-center justify-center">
          <iconify-icon icon="lucide:link" class="text-sky-500 text-sm"></iconify-icon>
        </div>
        <span class="font-mono text-xs text-slate-400 font-bold">{domain}</span>
      </div>

      <h1 class="text-2xl font-black text-slate-900 leading-snug mb-4">{data.title}</h1>
      <p class="text-slate-500 leading-relaxed font-medium mb-6">{data.description}</p>

      <!-- Tags -->
      <div class="flex flex-wrap gap-2 mb-6">
        {data.tags.map(tag => <TagChip tag={tag} />)}
      </div>

      <!-- Note -->
      {data.note && (
        <div class="bg-amber-50 border border-amber-100 rounded-2xl p-4 mb-6">
          <p class="text-sm text-amber-700 font-medium italic">{data.note}</p>
        </div>
      )}

      <!-- Footer row -->
      <div class="flex items-center justify-between pt-6 border-t border-slate-100">
        <span class="font-mono text-xs text-slate-300 font-bold">{dateStr}</span>
        <a
          href={data.url}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-6 py-3 bg-emerald-500 hover:bg-emerald-600 text-white rounded-2xl font-black text-sm transition-all shadow-lg shadow-emerald-200/50 hover:scale-105"
        >
          Open link
          <iconify-icon icon="lucide:external-link"></iconify-icon>
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
