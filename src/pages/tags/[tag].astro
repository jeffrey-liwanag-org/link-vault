---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BookmarkCard from '../../components/BookmarkCard.astro';
import TagChip from '../../components/TagChip.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const bookmarks = await getCollection('bookmarks');
  const tags = [...new Set(bookmarks.flatMap(b => b.data.tags))];
  return tags.map(tag => ({
    params: { tag },
    props: {
      bookmarks: bookmarks
        .filter(b => b.data.tags.includes(tag))
        .sort((a, b) => b.data.savedAt.getTime() - a.data.savedAt.getTime()),
    },
  }));
}

const { tag } = Astro.params;
const { bookmarks } = Astro.props;
---
<BaseLayout title={tag}>
  <div class="max-w-6xl mx-auto px-6 py-8">

    <div class="mb-8 reveal">
      <a href="/link-vault/tags" class="inline-flex items-center gap-1.5 text-sm text-ink-400 hover:text-ink-950 transition-colors mb-4 font-medium">
        ← All tags
      </a>
      <h1 class="text-3xl font-bold tracking-tight text-ink-950 mb-1">{tag}</h1>
      <p class="text-sm text-ink-400">{bookmarks.length} bookmark{bookmarks.length !== 1 ? 's' : ''}</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {bookmarks.map(b => (
        <BookmarkCard
          slug={b.slug}
          title={b.data.title}
          description={b.data.description}
          tags={b.data.tags}
          screenshot={b.data.screenshot}
          coverImage={b.data.coverImage}
          url={b.data.url}
          savedAt={b.data.savedAt}
        />
      ))}
    </div>

  </div>
</BaseLayout>
