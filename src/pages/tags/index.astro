---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TagChip from '../../components/TagChip.astro';
import { getCollection } from 'astro:content';

const bookmarks = await getCollection('bookmarks');
const tagCounts = bookmarks.reduce<Record<string, number>>((acc, b) => {
  b.data.tags.forEach(t => { acc[t] = (acc[t] ?? 0) + 1; });
  return acc;
}, {});
const tags = Object.entries(tagCounts).sort((a, b) => b[1] - a[1]);
---
<BaseLayout title="Tags">
  <div class="mb-8">
    <h1 class="text-2xl font-light tracking-widest uppercase mb-2">Tags</h1>
    <p class="text-space-steel text-sm">{tags.length} tags across {bookmarks.length} bookmarks</p>
  </div>

  <div class="flex flex-wrap gap-3">
    {tags.map(([tag, count]) => <TagChip tag={tag} count={count} />)}
  </div>
</BaseLayout>
