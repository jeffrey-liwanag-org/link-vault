---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TagChip from '../../components/TagChip.astro';
import { getCollection } from 'astro:content';

const bookmarks = await getCollection('bookmarks');
const tagCounts = bookmarks.reduce<Record<string, number>>((acc, b) => {
  b.data.tags.forEach(t => { acc[t] = (acc[t] ?? 0) + 1; });
  return acc;
}, {});
const tags = Object.entries(tagCounts).sort((a, b) => b[1] - a[1]);
---
<BaseLayout title="Tags">
  <div class="max-w-3xl mx-auto px-6">

    <div class="mb-10 reveal">
      <h1 class="text-5xl font-bold tracking-tight text-warm-950 mb-2">Tags</h1>
      <p class="text-warm-500 font-light">{tags.length} tags · {bookmarks.length} bookmarks</p>
    </div>

    <div class="bg-white rounded-4xl p-8 border border-stone-100 shadow-soft reveal">
      <div class="flex flex-wrap gap-3">
        {tags.map(([tag, count]) => <TagChip tag={tag} count={count} />)}
      </div>
    </div>

  </div>
</BaseLayout>
