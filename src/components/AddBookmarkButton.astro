---
<button
  id="add-bookmark-btn"
  class="flex items-center gap-2 px-3 py-2 text-sm bg-indigo-600 text-white rounded-lg font-medium hover:bg-indigo-500 transition-colors whitespace-nowrap"
>
  <svg class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
    <path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd" />
  </svg>
  Add
</button>

<script>
  document.getElementById('add-bookmark-btn')?.addEventListener('click', () => {
    const url = prompt('Bookmark URL:');
    if (!url || !url.trim()) return;
    const trimmed = url.trim();
    const title = encodeURIComponent(`Bookmark: ${trimmed}`);
    const body = encodeURIComponent(trimmed);
    const issueUrl = `https://github.com/jeffrey-liwanag-org/link-vault/issues/new?title=${title}&body=${body}&labels=bookmark`;
    window.open(issueUrl, '_blank');
    window.toast('Issue opened. Bookmark appears after enrichment (~1 min).', 'info');
  });
</script>
