---
---
<div class="relative w-full" id="search-wrapper">
  <svg class="absolute left-3.5 top-1/2 -translate-y-1/2 w-4 h-4 text-ink-400 pointer-events-none" viewBox="0 0 20 20" fill="currentColor">
    <path fill-rule="evenodd" d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z" clip-rule="evenodd" />
  </svg>
  <input
    id="search-input"
    type="search"
    placeholder="Search bookmarks..."
    autocomplete="off"
    class="w-full pl-10 pr-4 py-2.5 rounded-lg bg-white border border-ink-200 text-sm text-ink-950 placeholder-ink-400 focus:outline-none focus:ring-2 focus:ring-indigo-600/20 focus:border-indigo-400 transition-all"
  />
</div>

<script>
  const input = document.getElementById('search-input') as HTMLInputElement;

  function syncDisplay(card: HTMLElement) {
    card.style.display =
      (card.dataset.searchHidden === '1' || card.dataset.tagHidden === '1') ? 'none' : '';
  }

  function filterCards(q: string) {
    const query = q.toLowerCase().trim();
    document.querySelectorAll<HTMLElement>('[data-tags]').forEach(card => {
      const title = (card.dataset.title ?? '').toLowerCase();
      const domain = (card.dataset.domain ?? '').toLowerCase();
      const tags = (JSON.parse(card.dataset.tags ?? '[]') as string[]).join(' ').toLowerCase();
      card.dataset.searchHidden = (!query || title.includes(query) || domain.includes(query) || tags.includes(query)) ? '' : '1';
      syncDisplay(card);
    });
  }

  let debounce: ReturnType<typeof setTimeout>;
  input.addEventListener('input', () => {
    clearTimeout(debounce);
    debounce = setTimeout(() => filterCards(input.value), 150);
  });
</script>
