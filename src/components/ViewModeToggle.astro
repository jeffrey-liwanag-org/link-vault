---
---
<div class="flex items-center gap-1 bg-white border border-stone-200 rounded-full p-1 shadow-soft" id="view-toggle">
  <button data-view-btn="grid" title="Grid" class="view-btn p-2 rounded-full transition-all duration-200">
    <svg viewBox="0 0 16 16" fill="currentColor" class="w-4 h-4">
      <rect x="1" y="1" width="6" height="6" rx="1"/>
      <rect x="9" y="1" width="6" height="6" rx="1"/>
      <rect x="1" y="9" width="6" height="6" rx="1"/>
      <rect x="9" y="9" width="6" height="6" rx="1"/>
    </svg>
  </button>
  <button data-view-btn="list" title="List" class="view-btn p-2 rounded-full transition-all duration-200">
    <svg viewBox="0 0 16 16" fill="currentColor" class="w-4 h-4">
      <rect x="1" y="2" width="14" height="2" rx="1"/>
      <rect x="1" y="7" width="14" height="2" rx="1"/>
      <rect x="1" y="12" width="14" height="2" rx="1"/>
    </svg>
  </button>
  <button data-view-btn="headlines" title="Headlines" class="view-btn p-2 rounded-full transition-all duration-200">
    <svg viewBox="0 0 16 16" fill="currentColor" class="w-4 h-4">
      <rect x="1" y="2" width="14" height="2" rx="1"/>
      <rect x="1" y="7" width="9" height="2" rx="1"/>
      <rect x="1" y="12" width="11" height="2" rx="1"/>
    </svg>
  </button>
</div>
