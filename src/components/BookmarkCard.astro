---
interface Props {
  slug: string;
  title: string;
  description: string;
  tags: string[];
  screenshot?: string;
  coverImage?: string;
  url: string;
  savedAt: Date;
}
const { slug, title, description, tags, screenshot, coverImage, url, savedAt } = Astro.props;
const domain = new URL(url).hostname.replace('www.', '');
const dateStr = savedAt.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
const cover = coverImage || screenshot;
const initial = (domain[0] ?? title[0] ?? '?').toUpperCase();
---
<a
  href={`/link-vault/bookmarks/${slug}`}
  class="group block reveal"
  data-title={title}
  data-domain={domain}
  data-saved-at={savedAt.toISOString()}
>
  <!-- GRID variant -->
  <div class="card-grid bg-white rounded-3xl p-6 border border-stone-100 shadow-soft hover:shadow-card hover:-translate-y-0.5 transition-all duration-300">
    <div class="aspect-video overflow-hidden rounded-2xl mb-4 bg-stone-100 flex items-center justify-center">
      {cover
        ? <img src={cover} alt={title} class="w-full h-full object-cover" loading="lazy" />
        : <span class="text-4xl font-bold text-stone-300">{initial}</span>
      }
    </div>
    <p class="text-xs text-stone-400 mb-3">{dateStr}</p>
    <h2 class="text-stone-800 text-base font-semibold leading-snug mb-2 line-clamp-2 group-hover:text-coral transition-colors duration-200">
      {title}
    </h2>
    <p class="text-stone-400 text-sm leading-relaxed line-clamp-2 mb-4 font-light">{description}</p>
    <div class="flex items-end justify-between gap-2">
      <div class="flex flex-wrap gap-1.5">
        {tags.slice(0, 3).map(tag => (
          <span class="text-xs px-2.5 py-1 rounded-full bg-stone-100 text-stone-500 font-medium">{tag}</span>
        ))}
      </div>
      <span class="text-xs text-stone-300 font-mono flex-shrink-0">{domain}</span>
    </div>
  </div>

  <!-- LIST variant -->
  <div class="card-list bg-white rounded-2xl px-5 py-4 border border-stone-100 shadow-soft hover:shadow-card transition-all duration-300 flex gap-4 items-start">
    <div class="w-20 h-20 flex-shrink-0 rounded-xl overflow-hidden bg-stone-100 flex items-center justify-center">
      {cover
        ? <img src={cover} alt={title} class="w-full h-full object-cover" loading="lazy" />
        : <span class="text-2xl font-bold text-stone-300">{initial}</span>
      }
    </div>
    <div class="flex-1 min-w-0">
      <div class="flex items-center gap-2 mb-1">
        <span class="text-xs text-stone-300 font-mono">{domain}</span>
        <span class="text-xs text-stone-300">·</span>
        <span class="text-xs text-stone-400">{dateStr}</span>
      </div>
      <h2 class="text-stone-800 text-sm font-semibold leading-snug mb-1.5 line-clamp-1 group-hover:text-coral transition-colors duration-200">
        {title}
      </h2>
      <p class="text-stone-400 text-xs leading-relaxed line-clamp-2 font-light mb-2">{description}</p>
      <div class="flex flex-wrap gap-1">
        {tags.slice(0, 4).map(tag => (
          <span class="text-xs px-2 py-0.5 rounded-full bg-stone-100 text-stone-500 font-medium">{tag}</span>
        ))}
      </div>
    </div>
  </div>

  <!-- HEADLINES variant -->
  <div class="card-headline flex items-center gap-4 py-3.5 px-2 border-b border-stone-100 hover:bg-stone-50/60 transition-colors duration-150 rounded">
    <h2 class="flex-1 min-w-0 text-stone-800 text-sm font-medium truncate group-hover:text-coral transition-colors duration-200">
      {title}
    </h2>
    <span class="text-xs text-stone-300 font-mono flex-shrink-0 hidden sm:block">{domain}</span>
    <span class="text-xs text-stone-400 flex-shrink-0">{dateStr}</span>
  </div>
</a>
