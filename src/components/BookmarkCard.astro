---
interface Props {
  slug: string;
  title: string;
  description: string;
  tags: string[];
  screenshot?: string;
  url: string;
  savedAt: Date;
}
const { slug, title, description, tags, screenshot, url, savedAt } = Astro.props;
const domain = new URL(url).hostname.replace('www.', '');
const dateStr = savedAt.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
---
<a
  href={`/link-vault/bookmarks/${slug}`}
  class="group block bg-space-mid/40 border border-space-steel/20 rounded-lg overflow-hidden hover:border-accent/40 transition-all duration-200 hover:-translate-y-0.5"
>
  {screenshot && (
    <div class="aspect-video overflow-hidden bg-space-mid">
      <img src={screenshot} alt={title} class="w-full h-full object-cover opacity-80 group-hover:opacity-100 transition-opacity" loading="lazy" />
    </div>
  )}
  <div class="p-4">
    <p class="font-mono text-xs text-space-steel mb-1">{domain}</p>
    <h2 class="font-semibold text-white text-sm leading-snug mb-2 line-clamp-2">{title}</h2>
    <p class="text-space-steel text-xs leading-relaxed line-clamp-3 mb-3">{description}</p>
    <div class="flex flex-wrap gap-1.5">
      {tags.map(tag => (
        <span class="font-mono text-[10px] px-2 py-0.5 rounded-full border border-accent/30 text-accent/80">
          {tag}
        </span>
      ))}
    </div>
    <p class="font-mono text-[10px] text-space-steel/50 mt-3">{dateStr}</p>
  </div>
</a>
