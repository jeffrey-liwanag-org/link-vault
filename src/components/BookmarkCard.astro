---
interface Props {
  slug: string;
  title: string;
  description: string;
  tags: string[];
  screenshot?: string;
  url: string;
  savedAt: Date;
}
const { slug, title, description, tags, screenshot, url, savedAt } = Astro.props;
const domain = new URL(url).hostname.replace('www.', '');
const dateStr = savedAt.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
---
<a
  href={`/link-vault/bookmarks/${slug}`}
  class="group block bg-white rounded-3xl p-6 border border-stone-100 shadow-soft hover:shadow-card hover:-translate-y-0.5 transition-all duration-300 reveal"
>
  <!-- Timestamp -->
  <p class="text-sm text-stone-400 mb-4">{dateStr}</p>

  {screenshot && (
    <div class="aspect-video overflow-hidden bg-stone-50 rounded-2xl mb-4">
      <img src={screenshot} alt={title} class="w-full h-full object-cover" loading="lazy" />
    </div>
  )}

  <h2 class="text-stone-800 text-lg font-semibold leading-snug mb-2 line-clamp-2 group-hover:text-coral transition-colors duration-200">
    {title}
  </h2>

  <p class="text-stone-400 text-sm leading-relaxed line-clamp-2 mb-5 font-light">
    {description}
  </p>

  <div class="flex items-end justify-between gap-2">
    <div class="flex flex-wrap gap-1.5">
      {tags.slice(0, 3).map(tag => (
        <span class="text-xs px-2.5 py-1 rounded-full bg-stone-100 text-stone-500 font-medium">
          {tag}
        </span>
      ))}
    </div>
    <span class="text-xs text-stone-300 font-mono flex-shrink-0">{domain}</span>
  </div>
</a>
