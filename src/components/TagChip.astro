---
interface Props {
  tag: string;
  count?: number;
  active?: boolean;
}
const { tag, count, active = false } = Astro.props;
---
<a
  href={`/link-vault/tags/${tag}`}
  class:list={[
    'inline-flex items-center gap-2 text-sm px-4 py-2 rounded-lg border transition-all font-medium',
    active
      ? 'bg-indigo-600 border-indigo-600 text-white'
      : 'bg-white border-ink-200 text-ink-500 hover:border-indigo-400 hover:text-indigo-600',
  ]}
>
  {tag}
  {count !== undefined && (
    <span class:list={['text-xs rounded-md px-1.5 py-0.5', active ? 'bg-white/20 text-white' : 'bg-ink-100 text-ink-400']}>
      {count}
    </span>
  )}
</a>
