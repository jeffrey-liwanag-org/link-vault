---
interface Props {
  tag: string;
  count?: number;
  active?: boolean;
}
const { tag, count, active = false } = Astro.props;
---
<a
  href={`/link-vault/tags/${tag}`}
  class:list={[
    'inline-flex items-center gap-2 text-sm px-4 py-2 rounded-full border transition-all font-medium',
    active
      ? 'bg-coral border-coral text-white shadow-[0_4px_16px_-2px_rgba(255,183,178,0.4)]'
      : 'bg-white border-stone-200 text-warm-500 hover:border-coral hover:text-warm-950 shadow-soft',
  ]}
>
  {tag}
  {count !== undefined && (
    <span class:list={['text-xs rounded-full px-1.5 py-0.5', active ? 'bg-white/20 text-white' : 'bg-stone-100 text-stone-400']}>
      {count}
    </span>
  )}
</a>
