<script>
  declare global {
    interface Window {
      toast: (msg: string, kind?: 'success' | 'error' | 'info') => void;
    }
  }

  window.toast = (msg: string, kind: 'success' | 'error' | 'info' = 'info') => {
    const el = document.createElement('div');
    el.className = [
      'fixed bottom-6 right-6 z-[300] px-4 py-3 rounded-lg shadow-lg text-sm font-medium',
      'transition-opacity duration-300',
      kind === 'success' ? 'bg-green-600 text-white' :
      kind === 'error'   ? 'bg-red-600 text-white'   :
                           'bg-ink-950 text-white border border-ink-700',
    ].join(' ');
    el.textContent = msg;
    document.body.appendChild(el);
    setTimeout(() => {
      el.style.opacity = '0';
      setTimeout(() => el.remove(), 300);
    }, 3700);
  };
</script>
